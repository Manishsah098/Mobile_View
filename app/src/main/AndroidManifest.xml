<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/atlantis_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/atlantis_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtlantisTheRoyal"
        tools:targetApi="31">

        <!-- Launcher Activity: Welcome Screen -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Check-in + WhatsApp Verification Activity -->
        <activity
            android:name=".CheckInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Guest Dashboard Activity -->
        <activity
            android:name=".GuestDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AI Concierge Chat Activity -->
        <activity
            android:name=".AIChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

    </application>

</manifest>
