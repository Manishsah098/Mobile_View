<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gold_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#CC0D2235"
                android:endColor="#E606121C" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</ripple>
