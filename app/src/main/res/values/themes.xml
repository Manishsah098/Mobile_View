<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Luxury Theme -->
    <style name="Theme.AtlantisTheRoyal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/luxury_gold</item>
        <item name="colorPrimaryVariant">@color/bright_gold</item>
        <item name="colorOnPrimary">@color/dark_navy</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/bright_gold</item>
        <item name="colorSecondaryVariant">@color/gold_light</item>
        <item name="colorOnSecondary">@color/dark_navy</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/dark_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dark_navy</item>
        <item name="android:windowBackground">@color/dark_navy</item>

        <!-- Material Component Overrides -->
        <item name="cardViewStyle">@style/Widget.Atlantis.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.Atlantis.BottomNavigationView</item>
    </style>

    <!-- CardView Style -->
    <style name="Widget.Atlantis.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/glass_card_surface</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.Atlantis.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="backgroundTint">@color/nav_bar_bg</item>
        <item name="itemRippleColor">@color/gold_ripple</item>
        <item name="elevation">12dp</item>
    </style>
</resources>
